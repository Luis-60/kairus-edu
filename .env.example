# URL da API do Supabase. Local: http://127.0.0.1:54321 (veja `pnpm exec supabase status`).
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (pública por definição; o acesso real é controlado por RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL pública da aplicação, usada nos links de e-mail de recuperação de senha.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Chave do OpenRouter para as funções de IA (somente servidor; nunca prefixar com NEXT_PUBLIC_).
OPENROUTER_API_KEY=
# Modelo usado nas funções de IA (ID do OpenRouter). Padrão: anthropic/claude-opus-5.5
AI_MODEL=anthropic/claude-opus-5.5
